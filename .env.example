# Copy to .env and fill in real values. Never commit a filled-in .env.

# --- Database ---
DATABASE_URL=postgresql+psycopg2://postgres:aetherpass@localhost:5432/aetherai

# --- Auth ---
JWT_SECRET=replace-with-a-random-secret

# --- GitHub ingestion (optional; raises the public API rate limit from 60/hr to 5000/hr) ---
GITHUB_TOKEN=

# --- Jira ingestion (adapter present, not wired to a live router in this build; see LIMITATIONS.md) ---
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=

# --- Security scanners (import via POST /api/v1/security/findings/import) ---
SONAR_URL=http://localhost:9000
SONAR_TOKEN=
ZAP_URL=

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- ML ---
MODEL_ARTIFACT_DIR=./model_artifacts

# --- App ---
ENV=dev

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback


SMTP_HOST=smtp.gmail.com
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true